{
    "version": 2,
    "framework": null,
    "installCommand": "pip install -r requirements.txt",
    "functions": {
      "api/index.py": {
        "runtime": "python3.11",
        "includeFiles": "api/**/*"
      }
    },
    "rewrites": [
      { "source": "/static/(.*)", "destination": "/api/static/$1" },
      { "source": "/(.*)", "destination": "/api/index.py" }
    ]
  }
